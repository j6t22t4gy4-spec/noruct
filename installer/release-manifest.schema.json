{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noruct release manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "artifacts"],
  "properties": {
    "schema": { "const": "noruct.release-manifest.v3" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "employee_runtime"],
      "properties": {
        "wheel": { "$ref": "#/$defs/artifact" },
        "employee_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "targets"],
          "properties": {
            "distribution": { "const": "PyYAML" },
            "version": { "const": "6.0.3" },
            "targets": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "darwin-arm64": { "$ref": "#/$defs/abiArtifacts" },
                "darwin-x86_64": { "$ref": "#/$defs/abiArtifacts" },
                "linux-aarch64": { "$ref": "#/$defs/abiArtifacts" },
                "linux-x86_64": { "$ref": "#/$defs/abiArtifacts" },
                "windows-amd64": { "$ref": "#/$defs/abiArtifacts" },
                "windows-arm64": { "$ref": "#/$defs/abiArtifacts" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^?#]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "abiArtifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^cp3[1-9][0-9]$": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
